include "../../../datatables/def/datatable.rrpc"

struct UserItem {
    id        string
    username  string
    email     string
    firstName string
    lastName  string
    admin     bool
    active    bool
}

struct ListUsersResponse {
    users    []UserItem
    pageInfo DatatablePageInfo
}

struct UpdateUserRequest {
    username  string
    email     string
    firstName string
    lastName  string
    admin     bool
    active    bool
}

struct CreateUserRequest {
    username  string
    password  string
    email     string
    firstName string
    lastName  string
    admin     bool
    sendCredentialsEmail bool
}

error UserNotFound {
    code = 4
    http_code = 404
    message = "user not found"
}

error UserAlreadyExists {
    code = 5
    http_code = 409
    message = "username already taken"
}

@Path("api/admin/users")
service Users {
    @method("GET")
    @Path("")
    list(request DatatableRequest) (ListUsersResponse)
    @Path("")
    create(request CreateUserRequest) (UserItem)
    @Path("{id:string}")
    update(request UpdateUserRequest)
    @method("DELETE")
    @Path("{id:string}")
    delete()
}
struct UserItem {
    id        string
    username  string
    email     string
    firstName string
    lastName  string
    admin     bool
    active    bool
}

struct ListUsersResponse {
    users []UserItem
}

struct UpdateUserRequest {
    username  string
    email     string
    firstName string
    lastName  string
    admin     bool
    active    bool
}

error UserNotFound {
    code = 4
    http_code = 404
    message = "user not found"
}

@Path("api/admin/users")
service Users {
    @method("GET")
    @Path("")
    list() (ListUsersResponse)
    @Path("{id:string}")
    update(request UpdateUserRequest)
    @method("DELETE")
    @Path("{id:string}")
    delete()
}